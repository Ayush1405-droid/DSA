#Class
class Node:
    def __init__(self , val , next=None) :
        self.val = val
        self.next = next

    def __str__(self):
        return str(self.val)

Head = Node(1)
A = Node(2)
B = Node(3)
C = Node(4)

Head.next = A
A.next = B
B.next = C
# LOOP

arr =[1,2,3,4]

for i in range(len(arr)):
    print(arr[i])

##write in backward

index = len(arr)-1
while index >=0:
    print(index)
    index -= 1    
